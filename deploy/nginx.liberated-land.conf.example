# Example nginx configuration for liberated-land static site
# 
# To use:
# 1. Copy this file to your nginx sites-available directory:
#    sudo cp deploy/nginx.liberated-land.conf.example /etc/nginx/sites-available/liberated-land.conf
# 
# 2. Edit the file to set your actual domain name
# 
# 3. Enable the site:
#    sudo ln -s /etc/nginx/sites-available/liberated-land.conf /etc/nginx/sites-enabled/
# 
# 4. Test configuration:
#    sudo nginx -t
# 
# 5. Reload nginx:
#    sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    
    # Replace with your actual domain
    server_name liberated-land.example.com;
    
    # Point to the current release via symlink
    root /srv/apps/liberated-land/current;
    index index.html;
    
    # Logging
    access_log /var/log/nginx/liberated-land-access.log;
    error_log /var/log/nginx/liberated-land-error.log;
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    # Serve static files
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    
    # Cache GeoJSON data
    location ~* \.geojson$ {
        expires 1d;
        add_header Cache-Control "public";
        add_header Content-Type "application/json";
    }
    
    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript application/geo+json;
}

# SSL configuration (uncomment and configure after obtaining SSL certificate)
# You can use Let's Encrypt with certbot:
# sudo certbot --nginx -d liberated-land.example.com
#
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     
#     server_name liberated-land.example.com;
#     
#     ssl_certificate /etc/letsencrypt/live/liberated-land.example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/liberated-land.example.com/privkey.pem;
#     
#     # SSL configuration
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_ciphers HIGH:!aNULL:!MD5;
#     ssl_prefer_server_ciphers on;
#     
#     # Point to the current release via symlink
#     root /srv/apps/liberated-land/current;
#     index index.html;
#     
#     # ... (rest of the configuration same as above)
# }
#
